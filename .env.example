# ─── Sitio ────────────────────────────────────────────────────────────────────
# URL pública (canónicas, Open Graph, sitemap). Se incrusta en el build.
NEXT_PUBLIC_APP_URL=https://example.com

# ─── Shopify Storefront API (solo servidor) ───────────────────────────────────
# Ver .claude/02-storefront-api.md. Los tokens NUNCA van al repositorio.
SHOPIFY_STORE_DOMAIN=nqpafx-ad.myshopify.com
SHOPIFY_STOREFRONT_API_VERSION=2026-07
# Token privado del canal Headless (cabecera Shopify-Storefront-Private-Token).
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
# El token público no se usa: todas las llamadas salen del servidor.

# ─── Webhooks de Shopify → /api/revalidate ────────────────────────────────────
# Clave de firma de los webhooks (Ajustes → Notificaciones → Webhooks).
# Sin ella el endpoint responde 503 y el catálogo se refresca solo cada hora.
SHOPIFY_WEBHOOK_SECRET=
